# VU12 backlight control (RealDash Data Multicast -> ttyACM1)
#
# Install on the Odroid M2:
#   sudo cp vu12-backlight.service /etc/systemd/system/
#   sudo cp vu12_backlight.py /home/ek9/vu12_backlight.py
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vu12-backlight.service
#
# Runs as the ek9 user (already in the dialout group, no root needed for
# /dev/ttyACM1 access). Confirmed working on hardware 2026-07-25.

[Unit]
Description=VU12 backlight control (RealDash Data Multicast -> ttyACM1)
After=multi-user.target

[Service]
Type=simple
User=ek9
ExecStart=/usr/bin/python3 -u /home/ek9/vu12_backlight.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
