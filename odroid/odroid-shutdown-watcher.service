# VCU-triggered graceful shutdown (VCU TCP signal, port 35001 -> shutdown -h now)
#
# Install on the Odroid M2:
#   sudo cp odroid-shutdown-watcher.service /etc/systemd/system/
#   sudo cp odroid_shutdown_watcher.py /home/ek9/odroid_shutdown_watcher.py
#   sudo daemon-reload
#   sudo systemctl enable --now odroid-shutdown-watcher.service
#
# Runs as the ek9 user, which needs passwordless sudo for exactly this one command —
# add via visudo or a drop-in file (sudo visudo -f /etc/sudoers.d/odroid-shutdown):
#   ek9 ALL=(ALL) NOPASSWD: /usr/sbin/shutdown
#
# The script exits cleanly (code 0) after triggering a shutdown, so Restart=on-failure
# won't respawn it mid-shutdown — that only fires on a crash/non-zero exit, e.g. if the
# VCU connection itself misbehaves.

[Unit]
Description=VCU-triggered graceful shutdown watcher
After=multi-user.target

[Service]
Type=simple
User=ek9
ExecStart=/usr/bin/python3 -u /home/ek9/odroid_shutdown_watcher.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
