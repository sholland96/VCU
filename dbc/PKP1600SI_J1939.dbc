VAL_TABLE_ EnableDisable 1 "Enabled" 0 "Disabled" ;
VAL_TABLE_ LEDColor 9 "Yellow/green" 8 "Amber/orange" 7 "White/light blue" 6 "Magenta" 5 "Cyan" 4 "Yellow" 3 "Blue" 2 "Green" 1 "Red" 0 "Off" ;
VAL_TABLE_ LEDState 3 "Alternate blink" 2 "Blink" 1 "On" 0 "Off" ;
VAL_TABLE_ ContactState 1 "Pressed" 0 "Released" ;
VAL_TABLE_ BaudRateSel 3 "250 kbit/s" 2 "500 kbit/s" ;
