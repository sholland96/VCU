VAL_ 2565808384 Heartbeat_Enable 0 "Disabled (default)" 1 "Enabled" ;
VAL_ 2565808384 DemoMode_Enable 0 "Disabled (default)" 1 "Enabled" ;
VAL_ 2565808384 DefaultBacklightColor_Color 1 "Red" 2 "Green" 3 "Blue" 4 "Yellow" 5 "Cyan" 6 "Magenta (default: Amber, 8)" 7 "White/light blue" 8 "Amber/orange" 9 "Yellow/green" ;
VAL_ 2565865249 KeyContactState_ContactState 0 "Released" 1 "Pressed" ;
