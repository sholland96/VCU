VAL_ 2565808384 StartupLEDShow_Mode 0 "Off" 1 "Complete LED show (default)" 2 "Fast flash" ;
VAL_ 2565808384 LEDManagementMode_Mode 0 "Single LED state enabled (default)" 2 "Single/multiple LED state enabled" ;
